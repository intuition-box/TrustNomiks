# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the deployed app, used for auth email redirect links (signup confirmation, password reset).
# Local dev falls back to window.location.origin when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WalletConnect (get project ID at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Scripts only, never read by the app — required by scripts/republish-status.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional IPFS gateway host for scripts/verify-canonical-registry.ts (defaults to ipfs.io)
# PINATA_GATEWAY=

# Pinning happens via the Intuition GraphQL endpoint (no auth required).
