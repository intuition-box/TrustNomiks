# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the deployed app, used for auth email redirect links (signup confirmation, password reset).
# Local dev falls back to window.location.origin when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WalletConnect (get project ID at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# CoinGecko (server-side only, never exposed to the browser).
# Optional but strongly recommended: with no key the routes fall back to the keyless
# public endpoint, whose throttle is unpublished and trips within a handful of calls.
# A free Demo key (coingecko.com/en/api/pricing) lifts that to 100 req/min, 10k credits/mo.
# COINGECKO_API_KEY=your-coingecko-key
# 'demo' (default, api.coingecko.com) or 'pro' (pro-api.coingecko.com, paid plans).
# COINGECKO_API_TIER=demo
# Optional override of the requests/minute budget. Defaults per tier: public 10, demo 90, pro 250.
# COINGECKO_RATE_LIMIT_PER_MIN=

# Scripts only, never read by the app — required by scripts/republish-status.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional IPFS gateway host for scripts/verify-canonical-registry.ts (defaults to ipfs.io)
# PINATA_GATEWAY=

# Pinning happens via the Intuition GraphQL endpoint (no auth required).
